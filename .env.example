# Copy this to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql+psycopg://gymuser:gympass@localhost:5432/gymtracker

JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

ADMIN_EMAIL=you@example.com
ADMIN_CREATE_USER_KEY=change-me-long-random-string

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=Gym Tracker <you@gmail.com>

SITE_BASE_URL=http://localhost:8000

ENVIRONMENT=development
